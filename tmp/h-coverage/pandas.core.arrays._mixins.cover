    1:     def value_counts(self, dropna: bool = True) -> Series:
               """
               Return a Series containing counts of unique values.
       
               Parameters
               ----------
               dropna : bool, default True
                   Don't include counts of NA values.
       
               Returns
               -------
               Series
               """

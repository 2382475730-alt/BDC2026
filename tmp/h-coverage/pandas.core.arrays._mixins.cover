    2:     @doc(ExtensionArray.fillna)
    2:     def fillna(
    1:         self, value=None, method=None, limit: int | None = None, copy: bool = True
           ) -> Self:
               value, method = validate_fillna_kwargs(
                   value, method, validate_scalar_dict_value=False

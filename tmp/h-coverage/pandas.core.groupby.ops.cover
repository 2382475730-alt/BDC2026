    1: def _is_indexed_like(obj, axes, axis: AxisInt) -> bool:
           if isinstance(obj, Series):
               if len(axes) > 1:
                   return False
               return obj.axes[axis].equals(axes[axis])
           elif isinstance(obj, DataFrame):
               return obj.axes[axis].equals(axes[axis])
       
           return False
       
       

    2:     @cache_readonly
    2:     def codes_info(self) -> npt.NDArray[np.intp]:
               # return the codes of items in original grouped axis
               ids, _, _ = self.group_info
               if self.indexer is not None:
                   sorter = np.lexsort((ids, self.indexer))

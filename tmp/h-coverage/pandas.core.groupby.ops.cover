    2:     @cache_readonly
    2:     def _sorted_data(self) -> NDFrameT:
               return self.data.take(self._sort_idx, axis=self.axis)
       
    1:     def _chop(self, sdata, slice_obj: slice) -> NDFrame:
               raise AbstractMethodError(self)
       
       
    2: class SeriesSplitter(DataSplitter):
    1:     def _chop(self, sdata: Series, slice_obj: slice) -> Series:
               # fastpath equivalent to `sdata.iloc[slice_obj]`
               mgr = sdata._mgr.get_slice(slice_obj)
               ser = sdata._constructor_from_mgr(mgr, axes=mgr.axes)
               ser._name = sdata.name
               return ser.__finalize__(sdata, method="groupby")
       
       
    2: class FrameSplitter(DataSplitter):
    1:     def _chop(self, sdata: DataFrame, slice_obj: slice) -> DataFrame:
               # Fastpath equivalent to:
               # if self.axis == 0:
               #     return sdata.iloc[slice_obj]
               # else:
               #     return sdata.iloc[:, slice_obj]
               mgr = sdata._mgr.get_slice(slice_obj, axis=1 - self.axis)
               df = sdata._constructor_from_mgr(mgr, axes=mgr.axes)
               return df.__finalize__(sdata, method="groupby")
       
       
    1: def _get_splitter(
           data: NDFrame,
           labels: npt.NDArray[np.intp],
           ngroups: int,
           *,
           sort_idx: npt.NDArray[np.intp],
           sorted_ids: npt.NDArray[np.intp],
    1:     axis: AxisInt = 0,
       ) -> DataSplitter:
           if isinstance(data, Series):
               klass: type[DataSplitter] = SeriesSplitter
           else:
               # i.e. DataFrame
               klass = FrameSplitter
       
           return klass(
               data, labels, ngroups, sort_idx=sort_idx, sorted_ids=sorted_ids, axis=axis
           )

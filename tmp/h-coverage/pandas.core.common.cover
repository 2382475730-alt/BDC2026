                   "Indexing with a float is no longer supported. Manually convert "
                   "to an integer key instead."
               )
  164:     return val
       
       
    1: def not_none(*args):
           """
           Returns a generator consisting of the arguments that are not None.
           """
    4:     return (arg for arg in args if arg is not None)
       
       
    1: def any_none(*args) -> bool:
           """
           Returns a boolean indicating if any argument is None.
           """
           return any(arg is None for arg in args)
       
       
    1: def all_none(*args) -> bool:
           """
           Returns a boolean indicating if all arguments are None.
           """
           return all(arg is None for arg in args)
       
       
    1: def any_not_none(*args) -> bool:
           """
           Returns a boolean indicating if any argument is not None.
           """
    4:     return any(arg is not None for arg in args)
       
       
    1: def all_not_none(*args) -> bool:
           """
           Returns a boolean indicating if all arguments are not None.
           """
           return all(arg is not None for arg in args)
       
       
    1: def count_not_none(*args) -> int:
           """
           Returns the count of arguments that are not None.
           """
   12:     return sum(x is not None for x in args)
       
       

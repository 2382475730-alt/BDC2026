               result = np.asarray(values, dtype=object)
       
   38:     if result.ndim == 2:
               # Avoid building an array of arrays:
               values = [tuple(x) for x in values]
               result = construct_1d_object_array_from_listlike(values)
       
   38:     return result
       
       
    1: def index_labels_to_array(
    1:     labels: np.ndarray | Iterable, dtype: NpDtype | None = None
       ) -> np.ndarray:
           """
           Transform label or iterable of labels to array, for use in Index.
       
           Parameters
           ----------
           dtype : dtype
               If specified, use as dtype of the resulting array, otherwise infer.
       
           Returns
           -------
           array
           """
    1:     if isinstance(labels, (str, tuple)):
               labels = [labels]
       
    1:     if not isinstance(labels, (list, np.ndarray)):
               try:
                   labels = list(labels)
               except TypeError:  # non-iterable
                   labels = [labels]
       
    1:     labels = asarray_tuplesafe(labels, dtype=dtype)
       
    1:     return labels
       
       

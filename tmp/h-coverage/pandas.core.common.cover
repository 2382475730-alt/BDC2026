                       # GH#42461 cython will raise TypeError if we pass a subclass
                       key = list(key)
                   return lib.is_bool_list(key)
       
   13:     return False
       
       
    1: def cast_scalar_indexer(val):
           """
           Disallow indexing with a float key, even if that key is a round number.
       
           Parameters
           ----------
           val : scalar
       
           Returns
           -------
           outval : scalar
